{
  "name": "incremental-world-of-warcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke/smoke.mjs --log-level=warning && node .smoke/smoke.mjs",
    "render": "esbuild scripts/render.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.smoke/render.cjs --log-level=warning && node .smoke/render.cjs",
    "shots": "esbuild scripts/shots.ts --bundle --platform=node --format=cjs --jsx=automatic --outfile=.smoke/shots.cjs --log-level=warning && node .smoke/shots.cjs",
    "saves": "esbuild scripts/saves.ts --bundle --platform=node --format=cjs --outfile=.smoke/saves.cjs --log-level=warning && node .smoke/saves.cjs",
    "test": "npm run typecheck && npm run smoke && npm run saves && npm run render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
